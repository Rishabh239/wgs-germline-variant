/*
========================================================================================
    wgs-germline-nf configuration
========================================================================================
*/

params {
    // --- input / output ---
    input          = 'assets/samplesheet.csv'
    outdir         = 'results'
    multiqc_config = "${projectDir}/assets/multiqc_config.yaml"

    // --- reference (GATK GRCh38 bundle; see download_data.sh) ---
    fasta          = 'reference/Homo_sapiens_assembly38.fasta'
    dict           = 'reference/Homo_sapiens_assembly38.dict'
    dbsnp          = 'reference/Homo_sapiens_assembly38.dbsnp138.vcf'
    mills          = 'reference/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz'
    known_indels   = 'reference/Homo_sapiens_assembly38.known_indels.vcf.gz'

    // --- annotation ---
    snpeff_db      = 'GRCh38.105'   // `snpEff databases | grep -i GRCh38` to list
    snpeff_cache   = null           // optional: path to a pre-downloaded snpEff data dir
    skip_snpeff    = false          // set true (--skip_snpeff) to skip annotation entirely

    // --- behaviour ---
    trim           = false          // set true to run fastp adapter/quality trimming
    intervals      = null           // e.g. 'chr20' to restrict the whole run (fast local test)

    // --- optional GIAB benchmarking (hap.py) ---
    benchmark      = false
    truth_vcf      = 'reference/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz'
    truth_bed      = 'reference/HG002_GRCh38_1_22_v4.2.1_benchmark_noinconsistent.bed'
}

// ----------------------------------------------------------------------------
// Resource labels. resourceLimits caps every request so the same code runs on
// a laptop or on AWS (this replaces the old check_max function, which the
// Nextflow strict config parser no longer allows).
// ----------------------------------------------------------------------------
process {
    resourceLimits = [ cpus: 8, memory: '28.GB', time: '72.h' ]

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 8.GB  * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }
}

// ----------------------------------------------------------------------------
// Execution profiles.
// ----------------------------------------------------------------------------
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {
        // Self-contained chr20 sample dataset built by ./make_test_data.sh.
        // Everything is chr20-scoped, so the whole pipeline (incl. hap.py) runs
        // on a laptop in ~15-30 min. No 20 GB reference needed.
        params.fasta        = 'reference/chr20.fa'
        params.dict         = 'reference/chr20.dict'
        params.dbsnp        = 'reference/dbsnp138.chr20.vcf.gz'
        params.mills        = 'reference/mills.chr20.vcf.gz'
        params.known_indels = 'reference/mills.chr20.vcf.gz'
        params.truth_vcf    = 'reference/HG002.chr20.truth.vcf.gz'
        params.truth_bed    = 'reference/HG002.chr20.bed'
        params.benchmark    = true
        params.intervals    = null      // reference is already chr20-only
        // chr20 tasks are light; cap memory below a typical WSL2 VM (~7-8 GB).
        // If your VM has more/less RAM, adjust the memory value here.
        process.resourceLimits = [ cpus: 4, memory: '6.GB', time: '24.h' ]
    }
    awsbatch {
        process.executor       = 'awsbatch'
        process.queue          = System.getenv('AWS_BATCH_QUEUE') ?: 'wgs-germline-queue'
        aws.region             = System.getenv('AWS_REGION') ?: 'us-east-1'
        aws.batch.cliPath      = '/home/ec2-user/miniconda/bin/aws'
        // Use S3 for the work directory, e.g. -w s3://my-bucket/work
        process.resourceLimits = [ cpus: 16, memory: '64.GB', time: '72.h' ]
    }
}

// ----------------------------------------------------------------------------
// Reporting.
// ----------------------------------------------------------------------------
// Runtime metric reports (timeline/report/trace) need `ps` inside every task
// container; some minimal images lack it, which makes tasks fail. Disabled for
// portability -- the MultiQC report and all results are unaffected. Re-enable
// on an environment whose containers include procps if you want them.
timeline { enabled = false }
report   { enabled = false }
trace    { enabled = false }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html"; overwrite = true }

manifest {
    name            = 'wgs-germline-nf'
    author          = 'Rishabh Tripathi'
    description     = 'GATK4 best-practices germline short-variant pipeline (Nextflow DSL2, no ML)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}
